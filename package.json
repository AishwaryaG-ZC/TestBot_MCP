{
  "name": "healix-mcp-workspace",
  "version": "1.0.0",
  "description": "Healix MCP",
  "main": "index.js",
  "scripts": {
    "dev:webapp": "npm run dev -w webapp",
    "start:testbot": "npm start -w @healix/mcp",
    "test:webapp": "npm run test -w webapp",
    "test:testbot": "npm run test -w @healix/mcp",
    "compat:matrix": "node scripts/run-compat-matrix.mjs",
    "docker:build": "./webapp/docker/build.sh",
    "docker:run": "./webapp/docker/build.sh --run",
    "docker:migrate-run": "./webapp/docker/build.sh --run --migrate",
    "test:soap": "npm run test -w @healix/mcp -- --test-name-pattern soap",
    "start:pulseboard-soap": "node compat-fixtures/pulseboard-soap/src/server.js"
  },
  "workspaces": [
    "testbot-mcp",
    "webapp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishsharma1008/TestBot_MCP.git"
  },
  "keywords": [],
  "author": "Zapminds",
  "license": "MIT",
  "devDependencies": {
    "@playwright/mcp": "^0.0.61",
    "@playwright/test": "^1.58.2"
  }
}
